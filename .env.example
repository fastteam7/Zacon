# =============================================================================
# ZACON Contabilidade - Variáveis de Ambiente
# =============================================================================

# Ambiente
NODE_ENV=production

# Aplicação
NEXT_TELEMETRY_DISABLED=1

# Domínio (usado para SSL e configuração)
DOMAIN=zacon.com.br

# Email para Let's Encrypt
LETSENCRYPT_EMAIL=contato@zacon.com.br

# =============================================================================
# CMS FastTeam - Integração
# =============================================================================

# URL da API do CMS FastTeam
CMS_API_URL=https://api.fastteam.pro

# API Key para autenticação com o CMS
# Obtenha em: FastTeam > Configurações > CMS > API Key
CMS_API_KEY=sua_api_key_aqui

# Secret para validação de webhooks do CMS
# Use um token forte e único. Exemplo: openssl rand -base64 32
CMS_WEBHOOK_SECRET=seu_webhook_secret_aqui

# URL pública do site (usado para canonical URLs e sitemap)
NEXT_PUBLIC_SITE_URL=https://zacon.com.br
